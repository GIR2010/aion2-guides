---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import SkillTable from '../../../../components/SkillTable.astro';
import { locales, localeUrl, pick, t, type Locale } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const classes = await getCollection('classes');
  return locales.flatMap((lang) => classes.map((cls) => ({ params: { lang, id: cls.id }, props: { cls } })));
}

const { cls } = Astro.props;
const locale = Astro.params.lang as Locale;
const name = pick(cls.data.name, locale);
const byType = (type: 'active' | 'passive' | 'stigma') => cls.data.skills.filter((s) => s.type === type);
const guides = (
  await getCollection('guides', (g) => g.data.lang === locale && g.data.class?.id === cls.id)
).sort((a, b) => a.data.order - b.data.order);
const stigmaNote =
  locale === 'ru'
    ? 'Все стигмы открываются на 22 уровне. Слоты: 22 / 27 / 32 / 37.'
    : 'All Stigma unlock at level 22. Slots: 22 / 27 / 32 / 37.';
---

<Base locale={locale} title={name} description={pick(cls.data.summary, locale)}>
  <h1>{name}</h1>
  <p>{pick(cls.data.summary, locale)}</p>
  <p class="muted">{pick(cls.data.weapon, locale)}</p>

  {
    guides.length > 0 && (
      <>
        <h2>{t(locale, 'class.guides')}</h2>
        <ul>
          {guides.map((g) => (
            <li>
              <a href={localeUrl(locale, `guides/${g.id.split('/').slice(1).join('/')}`)}>{g.data.title}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <h2>{t(locale, 'class.skills')}</h2>
  <p class="note">{t(locale, 'draft.note')}</p>
  <h3>{t(locale, 'class.active')}</h3>
  <SkillTable skills={byType('active')} locale={locale} />
  <h3>{t(locale, 'class.passive')}</h3>
  <SkillTable skills={byType('passive')} locale={locale} />
  <h3>{t(locale, 'class.stigma')}</h3>
  <p class="muted">{stigmaNote}</p>
  <SkillTable skills={byType('stigma')} locale={locale} hideLevel />
</Base>
