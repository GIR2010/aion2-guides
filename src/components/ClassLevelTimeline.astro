---
import { getEntry } from 'astro:content';
import LevelTimeline from './LevelTimeline';
import { buildLevelTimeline } from '../lib/leveling';
import { t, type Locale } from '../i18n/ui';

interface Props {
  /** id плана прокачки из src/data/leveling, например "assassin-asmodian". */
  plan: string;
  locale: Locale;
}

const { plan: planId, locale } = Astro.props;
const plan = await getEntry('levelingPlans', planId);
if (!plan) throw new Error(`Unknown leveling plan: ${planId}`);
const levels = await buildLevelTimeline(plan, locale);

const labels = {
  level: t(locale, 'timeline.level'),
  pick: t(locale, 'timeline.pick'),
  newSkills: t(locale, 'timeline.newSkills'),
  skillUps: t(locale, 'timeline.skillUps'),
  skillUpsHint: t(locale, 'timeline.skillUpsHint'),
  points: t(locale, 'timeline.points'),
  specs: t(locale, 'timeline.specs'),
  pointsEarned: t(locale, 'timeline.pointsEarned'),
  pointsNeeded: t(locale, 'timeline.pointsNeeded'),
  pointsHint: t(locale, 'timeline.pointsHint'),
  unlocks: t(locale, 'timeline.unlocks'),
  todo: t(locale, 'timeline.todo'),
  zone: t(locale, 'timeline.zone'),
  exp: t(locale, 'timeline.exp'),
  nothing: t(locale, 'timeline.nothing'),
  changes: t(locale, 'timeline.changes'),
  build: t(locale, 'timeline.build'),
  buildHint: t(locale, 'timeline.buildHint'),
  budgetLevels: t(locale, 'timeline.budgetLevels'),
  budgetStones: t(locale, 'timeline.budgetStones'),
  pointsLeft: t(locale, 'timeline.pointsLeft'),
  cap: t(locale, 'timeline.cap'),
  others: t(locale, 'timeline.others'),
  stigmas: t(locale, 'timeline.stigmas'),
  stigmaSlot: t(locale, 'timeline.stigmaSlot'),
  notLearned: t(locale, 'timeline.notLearned'),
  shards: t(locale, 'timeline.shards'),
  macros: t(locale, 'timeline.macros'),
  daevanion: t(locale, 'timeline.daevanion'),
  skillTypes: {
    active: t(locale, 'class.active'),
    passive: t(locale, 'class.passive'),
    stigma: t(locale, 'class.stigma'),
  },
};
---

<LevelTimeline client:visible levels={levels} labels={labels} storageKey={`aion2-guide:level:${planId}`} />
