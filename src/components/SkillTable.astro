---
import type { CollectionEntry } from 'astro:content';
import { pick, t, type Locale } from '../i18n/ui';
import StatusBadge from './StatusBadge.astro';

type Skill = CollectionEntry<'classes'>['data']['skills'][number];

interface Props {
  skills: Skill[];
  locale: Locale;
  /** Скрыть колонку уровня (для стигм — у всех 22). */
  hideLevel?: boolean;
}

const { skills, locale, hideLevel = false } = Astro.props;
const sorted = [...skills].sort((a, b) => a.unlockLevel - b.unlockLevel);
const sec = locale === 'ru' ? 'с' : 's';
const lvl = t(locale, 'skill.level');
---

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        {!hideLevel && <th>{lvl}</th>}
        <th>{t(locale, 'skill.name')}</th>
        <th>{t(locale, 'skill.cooldown')}</th>
        <th>{t(locale, 'skill.effect')}</th>
        <th>{t(locale, 'skill.status')}</th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((s) => (
          <tr id={s.id}>
            {!hideLevel && <td>{s.unlockLevel}</td>}
            <td>
              <strong>{pick(s.name, locale)}</strong>
              {locale === 'ru' && s.name.ru === null && <div class="muted small">{t(locale, 'skill.ruPending')}</div>}
              {locale === 'ru' && s.name.en && s.name.ru && <div class="muted small">{s.name.en}</div>}
            </td>
            <td class="nowrap">
              {s.cooldown === null ? '—' : `${s.cooldown} ${sec}`}
              {s.mpCost !== null && (
                <div class="muted small">
                  {s.mpCost} {t(locale, 'skill.mp')}
                </div>
              )}
            </td>
            <td>
              {pick(s.effect, locale)}
              {s.specs.length > 0 && (
                <details>
                  <summary>{t(locale, 'skill.specs')}</summary>
                  <ul>
                    {s.specs.map((sp) => (
                      <li>
                        <span class="muted">
                          {lvl} {sp.level}:
                        </span>{' '}
                        {pick(sp.text, locale)}
                      </li>
                    ))}
                  </ul>
                </details>
              )}
              {s.note && <div class="small warn">⚠ {pick(s.note, locale)}</div>}
            </td>
            <td>
              <StatusBadge status={s.status} locale={locale} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .small {
    font-size: 0.8rem;
  }
  .nowrap {
    white-space: nowrap;
  }
  .warn {
    color: var(--warn);
    margin-top: 4px;
  }
  details {
    margin-top: 6px;
    font-size: 0.875rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
  }
  details ul {
    margin: 4px 0 0;
    padding-left: 18px;
  }
</style>
